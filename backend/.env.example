# Server
PORT=5000

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rideshare?schema=public

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated extra frontend origins allowed by CORS
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Smart matching
MATCH_RADIUS_METERS=100
MATCH_TIME_WINDOW_MINUTES=15

# Nominatim etiquette: a generic User-Agent identifying the app
GEOCODER_USER_AGENT=RideShareDemo/1.0 (student demo project)
